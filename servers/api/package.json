{
  "name": "@workspace/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "tsx --test features/health/tests/*.test.ts features/tasks/tests/*.test.ts tests/chat.test.ts tests/concurrency.test.ts tests/e2e.test.ts tests/environment.test.ts tests/http-boundaries.test.ts tests/mongodb.test.ts tests/multiuser.test.ts tests/shutdown.test.ts tests/stress.test.ts",
    "test:chat": "tsx --test tests/chat.test.ts",
    "test:concurrency": "tsx --test tests/concurrency.test.ts",
    "test:stress": "tsx --test tests/stress.test.ts",
    "test:multiuser": "tsx --test tests/multiuser.test.ts",
    "test:e2e": "tsx --test tests/e2e.test.ts",
    "lint": "eslint \"**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workspace/logging": "workspace:*",
    "@workspace/types": "workspace:*",
    "dotenv": "^17.2.2",
    "express": "^5.2.1",
    "mongoose": "^9.10.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "@types/ws": "^8.18.2",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/tsconfig": "workspace:*",
    "eslint": "9.39.5",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
